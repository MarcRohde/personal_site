---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/writing';

interface Props {
  posts: CollectionEntry<'writing'>[];
  upcoming?: boolean;
}

const { posts, upcoming = false } = Astro.props;
const Row = upcoming ? 'div' : 'a';
---
<ul class="writing">
  {posts.map((post) => (
    <li>
      <Row class="row" href={upcoming ? undefined : `/writing/${post.id}/`}>
        {upcoming
          ? <span class="status">In progress</span>
          : <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>}
        <span class="body">
          <span class="title">{post.data.title}{!upcoming && post.data.draft && <span class="draft"> (draft)</span>}</span>
          <span class="summary">{post.data.summary}</span>
        </span>
      </Row>
    </li>
  ))}
</ul>

<style>
  .writing { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .writing li { border-bottom: 1px solid var(--line); }
  .row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.25rem 0;
    text-decoration: none;
  }
  time, .status {
    padding-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .body { display: grid; gap: 0.25rem; }
  .title { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.01em; }
  a.row:hover .title { text-decoration: underline; text-underline-offset: 0.2em; }
  .summary { color: var(--muted); }
  .draft { font-weight: 400; color: var(--muted); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
