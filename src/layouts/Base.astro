---
import profile from '../data/profile.json';
import SocialLinks from '../components/SocialLinks.astro';
import { getPublishedWriting } from '../lib/writing';

interface Props {
  title: string;
  description?: string;
}

const { title, description = profile.tagline } = Astro.props;
const hasWriting = (await getPublishedWriting()).length > 0;
const nav = [
  { label: 'Home', href: '/' },
  ...(hasWriting ? [{ label: 'Writing', href: '/writing/' }] : []),
  { label: 'Toolbox', href: '/toolbox/' },
];
const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} - Writing`} href={new URL('/writing/rss.xml', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href="/fonts/newsreader-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Google tag (gtag.js); is:inline stops Astro from bundling these scripts -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B724YKYBB3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-B724YKYBB3');
    </script>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="monogram" href="/" aria-label={`${profile.name} home`}>MR</a>
        <nav class="site-nav" aria-label="Site">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === normalize(n.href) || (n.href !== '/' && current.startsWith(normalize(n.href))) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} {profile.name}</p>
        <SocialLinks size="sm" />
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Newsreader";
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url("/fonts/newsreader-latin-variable.woff2") format("woff2");
  }
  @font-face {
    font-family: "Source Sans 3";
    font-style: normal;
    font-weight: 200 900;
    font-display: swap;
    src: url("/fonts/source-sans-3-latin-variable.woff2") format("woff2");
  }
  :root {
    --fg: #0a0a0a;
    --muted: #6b6b6b;
    --line: #e6e6e6;
    --line-strong: #cfcfcf;
    --bg: #ffffff;
    --font-display: "Newsreader", Georgia, serif;
    --font-body: "Source Sans 3", "Helvetica Neue", Arial, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #f5f5f5; --muted: #9a9a9a; --line: #222; --line-strong: #3a3a3a; --bg: #0a0a0a; }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--fg);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }
  .page {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
  }
  a { color: inherit; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .monogram {
    font-weight: 700;
    text-decoration: none;
    font-size: 1.125rem;
  }
  .site-nav { display: flex; gap: 2rem; }
  .site-nav a {
    font-size: 0.75rem;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    padding-bottom: 0.25rem;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover,
  .site-nav a[aria-current="page"] { color: var(--fg); border-bottom-color: var(--fg); }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 500;
    line-height: 1.05;
  }
  h2 {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--muted);
  }
  .prose { max-width: 38rem; }
  .prose p { margin: 0 0 1.25rem; }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .site-footer p { margin: 0; }
  @media (max-width: 760px) {
    h1 { font-size: 2.75rem; }
  }
</style>
