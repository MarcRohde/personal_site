---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import profile from '../../data/profile.json';
import { getPublishedWriting, formatDate } from '../../lib/writing';

export async function getStaticPaths() {
  const posts = await getPublishedWriting();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — ${profile.name}`} description={post.data.summary}>
  <main>
    <article class="article">
      <header class="article-head">
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.draft && <span> &middot; Draft</span>}
        </p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.summary}</p>
      </header>
      <div class="article-body">
        <Content />
      </div>
      <footer class="article-foot">
        <a href="/writing/">&larr; All writing</a>
      </footer>
    </article>
  </main>
</Base>

<style>
  .article { max-width: 40rem; }
  .article-head { padding: clamp(2rem, 5vw, 3.5rem) 0 2rem; border-bottom: 1px solid var(--line); }
  .article-head h1 { font-size: 3.25rem; line-height: 1.1; }
  .meta { margin: 0 0 1rem; font-size: 0.8125rem; color: var(--muted); }
  .lede { margin: 1.25rem 0 0; color: var(--muted); font-size: 1.125rem; }
  .article-body { padding-top: 2rem; font-size: 1.125rem; line-height: 1.75; }
  .article-body :global(p) { margin: 0 0 1.4rem; }
  .article-body :global(h2) {
    margin: 2.75rem 0 1rem;
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: none;
    color: var(--fg);
  }
  .article-body :global(h3) { margin: 2rem 0 0.75rem; font-size: 1.2rem; }
  .article-body :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--fg);
    font-size: 1.25rem;
  }
  .article-body :global(ul), .article-body :global(ol) { padding-left: 1.25rem; margin: 0 0 1.4rem; }
  .article-body :global(li) { margin-bottom: 0.4rem; }
  .article-body :global(img) { max-width: 100%; height: auto; filter: grayscale(1); }
  .article-body :global(.story-photo) { margin: 2rem 0 2.25rem; }
  .article-body :global(.story-photo img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: none;
    border-radius: 2px;
  }
  .article-body :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
  .article-foot { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 0.9375rem; }
  @media (max-width: 760px) {
    .article-head h1 { font-size: 2.25rem; }
  }
</style>
