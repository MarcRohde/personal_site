---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
---
<Base title={profile.title}>
  <header>
    <h1>{profile.name}</h1>
    <p class="tagline">{profile.tagline}</p>
    <nav aria-label="Social profiles">
      {profile.social.map((s) => (
        <a href={s.url} rel="noopener noreferrer me" target="_blank">{s.label}</a>
      ))}
    </nav>
  </header>
  <main>
    <section>
      {profile.bio.map((p) => <p>{p}</p>)}
    </section>
    <section>
      <h2>{profile.learning.heading}</h2>
      <ul>
        {profile.learning.items.map((i) => <li>{i}</li>)}
      </ul>
    </section>
  </main>
</Base>
