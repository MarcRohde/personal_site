---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import WritingList from '../components/WritingList.astro';
import profile from '../data/profile.json';
import { getPublishedWriting } from '../lib/writing';

const roles = profile.tagline.split('.').map((r) => r.trim()).filter(Boolean);
const ctaLinks = profile.social.filter((s) => s.cta);
const recent = (await getPublishedWriting()).slice(0, 3);
// With nothing published yet, list draft working titles (unlinked) so the section isn't empty.
const upcoming = recent.length ? [] : (await getCollection('writing', ({ data }) => data.draft)).slice(0, 3);
const hasEmail = profile.email.includes('@');
---
<Base title={profile.seo.title} description={profile.seo.description}>
  <main>
    <section class="hero">
      <h1>{profile.name}</h1>
      <ul class="roles">
        {roles.map((r) => <li>{r}</li>)}
      </ul>
      <p class="availability">{profile.availability}</p>
      <div class="connect">
        <SocialLinks />
        <ul class="cta-links">
          {ctaLinks.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer me" target="_blank">{s.cta}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="highlights">
      <h2>Highlights</h2>
      <ul class="highlight-grid">
        {profile.highlights.map((h) => (
          <li>
            <span class="figure">{h.figure}</span>
            <span class="label">{h.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="about">
      <h2>About</h2>
      <div class="about-body">
        <figure class="portrait">
          <img
            src={profile.photo.src}
            alt={profile.photo.alt}
            width={profile.photo.width}
            height={profile.photo.height}
          />
        </figure>
        {profile.bio.map((p) => {
          const [before, ...rest] = p.split(profile.employer.name);
          return rest.length
            ? <p>{before}<a href={profile.employer.url} rel="noopener noreferrer" target="_blank">{profile.employer.name}</a>{rest.join(profile.employer.name)}</p>
            : <p>{p}</p>;
        })}
      </div>
    </section>

    <section class="recent">
      <div class="recent-head">
        <h2>Writing</h2>
        <a href="/writing/">All writing &rarr;</a>
      </div>
      {recent.length > 0
        ? <WritingList posts={recent} />
        : <WritingList posts={upcoming} upcoming />}
    </section>

    <section class="section">
      <h2>{profile.learning.heading}</h2>
      <ol class="focus">
        {profile.learning.items.map((i, n) => (
          <li><span class="index">{String(n + 1).padStart(2, '0')}</span>{i}</li>
        ))}
      </ol>
    </section>

    <section class="section contact" id="contact">
      <h2>Contact</h2>
      <div>
        <p class="contact-email">
          {hasEmail ? <a href={`mailto:${profile.email}`}>{profile.email}</a> : profile.email}
        </p>
        <ul class="cta-links">
          {ctaLinks.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer me" target="_blank">{s.cta}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--line);
  }
  .availability { margin: 0 0 1.5rem; font-size: 0.9375rem; color: var(--muted); }
  .connect { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .cta-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 0; padding: 0; list-style: none; font-size: 0.9375rem; }

  .highlights {
    padding: clamp(1.75rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .highlight-grid li { display: grid; gap: 0.35rem; padding-top: 1rem; border-top: 1px solid var(--fg); }
  .figure { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .label { font-size: 0.9375rem; color: var(--muted); }

  .contact-email { margin: 0 0 0.75rem; font-size: clamp(1.25rem, 2.4vw, 1.625rem); font-weight: 500; }

  .about {
    padding: clamp(1.75rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .about-body {
    display: flow-root;
    max-width: 60rem;
  }
  .about-body p { margin: 0 0 1.25rem; }
  .recent {
    padding: clamp(1.75rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .recent-head { display: flex; justify-content: space-between; align-items: baseline; }
  .recent-head a { font-size: 0.875rem; color: var(--muted); text-decoration: none; }
  .recent-head a:hover { color: var(--fg); }
  .portrait {
    float: right;
    width: 40%;
    max-width: 24rem;
    margin: 0.35rem 0 1.5rem clamp(1.5rem, 4vw, 3rem);
  }
  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1);
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    margin: 1.25rem 0 0.75rem;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 1.125rem;
  }
  .roles li:not(:last-child)::after {
    content: "/";
    margin: 0 0.6rem;
    color: var(--line-strong);
  }

  .section {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding: clamp(1.75rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .section h2 { margin: 0.35rem 0 0; }

  .focus { margin: 0; padding: 0; list-style: none; }
  .focus li {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .focus li:last-child { border-bottom: 1px solid var(--line); }
  .index {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .section { grid-template-columns: 1fr; }
    .portrait { float: none; width: 100%; max-width: 22rem; margin: 0 0 1.75rem; }
  }
</style>
